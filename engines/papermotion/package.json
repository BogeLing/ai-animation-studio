{
  "name": "ai-animation-studio-papermotion",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The papermotion paper cut-out engine with a parallel/GPU renderer, reusable scene modules and example films, for films written as code by AI agents.",
  "papermotion": "0.1.0",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "vite",
    "render": "node scripts/render.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "grab": "node scripts/grab.ts",
    "scout": "node scripts/scout.ts",
    "sheet": "node scripts/sheet.ts",
    "listen": "node scripts/listen.ts",
    "render:fast": "node scripts/render-parallel.ts",
    "smoke": "node scripts/smoke.ts",
    "render:detached": "bash scripts/render-detached.sh",
    "bench": "bash scripts/bench-cgroup.sh"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
